# Copy to .env.local (git-ignored, chmod 600) or let scripts/splunk-droplet.sh up write it.
# Load before running dea against a real Splunk:  set -a; . .env.local; set +a
SPLUNK_HOST=203.0.113.10
SPLUNK_PORT=8089
SPLUNK_TOKEN=replace-with-splunk-bearer-token
# SPLUNK_VERIFY=0 and SPLUNK_OWNER=admin are what scripts/splunk-droplet.sh up writes for the throwaway droplet (self-signed cert); never use 0 against another host.
SPLUNK_VERIFY=1
SPLUNK_APP=search
SPLUNK_OWNER=nobody
SPLUNK_ADMIN_PASSWORD=replace-me
SPLUNK_WEB=https://203.0.113.10:8000
